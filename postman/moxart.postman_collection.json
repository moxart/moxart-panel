{
  "info": {
    "name": "Moxart Panel API",
    "description": "Requests for the Moxart Panel Flask API.\n\n1. Set `base_url` (default `http://localhost:5000`) and the `username`/`password` collection variables.\n2. Run **Auth / Login**. It stores `access_token` and `refresh_token`; every other request sends `Authorization: Bearer {{access_token}}` (inherited from the collection).\n3. **Users / Get user** and others use `{{user_public_id}}`, which is saved by **Users / List users (admin)** or set by hand. **Posts / Create post** saves `post_public_id` and `post_slug`; **Categories / Create category** saves `category_public_id`.\n\nNotes: post creation, upload and `/api/user/*` require a confirmed account (open the link from Mailpit at http://localhost:8025). `/api/users`, `/dashboard/*` and category creation require an admin. Login is limited to 10/minute and register to 10/hour. Postman also stores the JWT cookies the API sets; the header is read first, so they don't interfere.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000"
    },
    {
      "key": "username",
      "value": "moxart"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "email",
      "value": "user@example.com"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "user_public_id",
      "value": ""
    },
    {
      "key": "post_public_id",
      "value": ""
    },
    {
      "key": "post_slug",
      "value": ""
    },
    {
      "key": "category_public_id",
      "value": ""
    },
    {
      "key": "confirm_token",
      "value": ""
    },
    {
      "key": "reset_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Creates a guest account, sends a confirmation email and returns tokens. Password must be at least 8 characters."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.access_token) pm.collectionVariables.set('access_token', body.access_token);",
                  "if (body.refresh_token) pm.collectionVariables.set('refresh_token', body.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.access_token) pm.collectionVariables.set('access_token', body.access_token);",
                  "if (body.refresh_token) pm.collectionVariables.set('refresh_token', body.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh access token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/token/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "token",
                "refresh"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{refresh_token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Sends the refresh token as the bearer token and stores the new access token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.access_token) pm.collectionVariables.set('access_token', body.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "logout"
              ]
            },
            "description": "Revokes the current access token by adding its jti to the blocklist."
          }
        }
      ]
    },
    {
      "name": "Account",
      "item": [
        {
          "name": "Confirm email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/confirm/{{confirm_token}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "confirm",
                "{{confirm_token}}"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Copy the token from the confirmation email link into `confirm_token`."
          }
        },
        {
          "name": "Check confirmation status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/unconfirmed",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "unconfirmed"
              ]
            }
          }
        },
        {
          "name": "Resend confirmation email",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/resend/confirm",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "resend",
                "confirm"
              ]
            },
            "description": "Limited to 3 per hour."
          }
        },
        {
          "name": "Request password reset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/send/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "send",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Always returns 200. The email contains the reset token; copy it into `reset_token`."
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/reset/password/{{reset_token}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "reset",
                "password",
                "{{reset_token}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"new-password-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Each reset token works once. All existing JWTs stop working after the password changes."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Admin only. Saves the first user's public id into `user_public_id`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (Array.isArray(body) && body.length) pm.collectionVariables.set('user_public_id', body[0].user_public_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/user/{{user_public_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "{{user_public_id}}"
              ]
            },
            "description": "Confirmed users only. Non-owners see only public fields."
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/user/{{user_public_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "{{user_public_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"display_name\": \"Moxart\",\n  \"bio\": \"Hello\",\n  \"location\": \"Earth\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Partial update. Accepted fields: username, email, password (needs current_password unless admin), first_name, last_name, nickname, url, bio, location, display_name. Changing the email marks the account unconfirmed."
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/user/{{user_public_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "{{user_public_id}}"
              ]
            },
            "description": "The user themselves or an admin."
          }
        }
      ]
    },
    {
      "name": "Dashboard (admin)",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/dashboard/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dashboard",
                "users"
              ]
            }
          }
        },
        {
          "name": "Delete user by username",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/dashboard/user/{{username}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dashboard",
                "user",
                "{{username}}"
              ]
            },
            "description": "Careful: this uses the `username` variable, which defaults to your own login."
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create category (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/category",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "category"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_name\": \"News\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.category_public_id) pm.collectionVariables.set('category_public_id', body.category_public_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/category/{{category_public_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "category",
                "{{category_public_id}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/categories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "categories"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/post",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "post"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hello world\",\n  \"content\": \"<p>First post</p>\",\n  \"category_public_id\": \"{{category_public_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Confirmed users only. Omit `category_public_id` to use the default 'uncategorized' category. HTML content is sanitized."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.post_public_id) {",
                  "  pm.collectionVariables.set('post_public_id', body.post_public_id);",
                  "  pm.sendRequest({url: pm.collectionVariables.get('base_url') + '/api/post/' + body.post_public_id, method: 'GET'},",
                  "    (err, res) => { if (!err) pm.collectionVariables.set('post_slug', res.json().data.title_slug); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get post",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/post/{{post_public_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "post",
                "{{post_public_id}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Get post by slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/post/slug/{{post_slug}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "post",
                "slug",
                "{{post_slug}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Edit post",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/post/{{post_public_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "post",
                "{{post_public_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hello world (edited)\",\n  \"content\": \"<p>Updated content</p>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "The author or an admin, with a confirmed account. Send any of title, content, category_public_id; fields you leave out are kept. The slug does not change when the title does."
          }
        },
        {
          "name": "List posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/posts?page=1&per_page=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "posts"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "20",
                  "description": "max 100"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Delete post",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/post/{{post_public_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "post",
                "{{post_public_id}}"
              ]
            },
            "description": "The author or an admin."
          }
        }
      ]
    },
    {
      "name": "Uploads",
      "item": [
        {
          "name": "Upload files",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/upload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "upload"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Pick one or more files; repeat the key for more"
                }
              ]
            },
            "description": "Confirmed users only. Allowed extensions come from UPLOAD_VALID_FILE."
          }
        }
      ]
    }
  ]
}